    "third_party/Quake-2/game"
  ],
  "patches": [
    {
      "file": "third_party/Quake-2/game/g_items.c",
      "pattern": "^static int\\t(jacket|combat|body)_armor_index;",
      "replace": "int\\t\\1_armor_index;",
      "count": 3,
      "why": "GCC rejects static after extern (g_local.h); MSVC accepted it. Variables are only used in g_items.c, so linkage change is behaviour-neutral."
    }
  ],
  "pilot_functions": [
    "M_ChangeYaw",
    "G_FreeEdict",
    "M_CheckGround",
    "M_SetEffects",
    "range",
    "visible",
    "infront",
    "CanDamage",
    "trigger_counter_use",
    "G_Spawn"
  ],
  "reconstruct": [
    "M_ChangeYaw",
    "G_FreeEdict",
    "M_CheckGround",
    "M_SetEffects",
    "range",
    "visible",
    "infront",
    "CanDamage",
    "trigger_counter_use",
    "G_Spawn"
  ],
  "stateful": {
    "M_ChangeYaw": "self",
    "G_FreeEdict": "self",
    "M_CheckGround": "self",
    "M_SetEffects": "self",
    "range": "pair",
    "visible": "pair",
    "infront": "pair",
    "CanDamage": "pair",
    "trigger_counter_use": "use",
    "G_Spawn": "spawn"
  },
  "agent_a_model": "agent-a-model"
}
